# Reference only. The supported path is scripts/init_deployment.py, which writes
# a private production.env outside the Git worktree.
MANUSCRIPT_DESK_PUBLIC_BASE_URL=https://desk.example.com
MANUSCRIPT_DESK_COOKIE_SECURE=1
MANUSCRIPT_DESK_CREATE_EMPTY_DB=1
WEB_CONCURRENCY=1

# First boot only: configure all three values, then remove them with
# scripts/finalize_bootstrap.py after the first successful administrator login.
MANUSCRIPT_DESK_INITIAL_ADMIN_USERNAME=admin
MANUSCRIPT_DESK_INITIAL_ADMIN_EMAIL=admin@example.com
MANUSCRIPT_DESK_INITIAL_ADMIN_PASSWORD_FILE=/run/manuscript-desk-bootstrap/initial-admin-password

# The Compose file supplies database, SecretStore, browser, and key-file paths.
MANUSCRIPT_DESK_LISTEN_ADDRESS=127.0.0.1
MANUSCRIPT_DESK_PORT=8008
